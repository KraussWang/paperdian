{
  "name": "paperdian",
  "version": "0.3.0",
  "private": true,
  "description": "Obsidian workbench for Claude Code paper reading and WeChat draft creation.",
  "license": "MIT",
  "scripts": {
    "build": "node esbuild.mjs production",
    "dev": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run build && vitest run",
    "test:coverage": "npm run build && vitest run --coverage",
    "coverage": "npm run test:coverage",
    "check": "npm run typecheck && npm run lint && npm test",
    "package:release": "npm run build && node scripts/package-release.cjs",
    "smoke:install": "npm run package:release && node scripts/smoke-install.cjs",
    "privacy:check": "node scripts/privacy-check.cjs"
  },
  "dependencies": {
    "highlight.js": "11.12.0",
    "juice": "11.1.1",
    "katex": "0.19.0",
    "marked": "15.0.12",
    "socks": "2.8.7",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "5.0.4",
    "esbuild": "0.28.2",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "obsidian": "^1.8.7",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "5.0.4"
  }
}
