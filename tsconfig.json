{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "lib": ["DOM", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node", "vitest/globals"],
    "useUnknownInCatchVariables": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "vitest.config.mts", "eslint.config.mjs", "esbuild.mjs"]
}
